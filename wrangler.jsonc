{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-defi-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp-defi.datasnag.com/*",
      "zone_name": "datasnag.com"
    }
  ]
}
